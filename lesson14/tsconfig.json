{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "mocha"],
    "strict": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "outDir": "dist"
  },
  "ts-node": {
    "files": true,
    "transpileOnly": true
  },
  "include": ["api/**/*.ts", "tests/**/*.ts"]
}
